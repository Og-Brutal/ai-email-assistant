# Copy this file to .env and fill in the values. Never commit .env.

# ---------- App ----------
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Only this Gmail account can use the app
ALLOWED_EMAIL=you@gmail.com
# Signs session cookies and approval tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Encrypts the stored Google token: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# ---------- Google OAuth (Phase 1) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ---------- Gemini ----------
GOOGLE_API_KEY=

# ---------- Qdrant Cloud (Phase 5) ----------
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Neon Postgres (Phase 1) ----------
DATABASE_URL=
